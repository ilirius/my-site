{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "pixel-and-code",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "website:build": "turbo run build --filter=web",
    "website:dev": "turbo run dev --filter=web",
    "docs:build": "turbo run build --filter=docs",
    "docs:dev": "turbo run dev --filter=docs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "browser": {
    "fs": false
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.8.0",
    "turbo": "^2.10.9",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@11.21.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
